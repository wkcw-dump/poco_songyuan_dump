			nvt_xtal_en_active {
				phandle = <0x24d>;

				mux {
					function = "gpio";
					pins = "gpio29";
				};

				config {
					output-high;
					bias-pull-down;
					drive-strength = <0x02>;
					pins = "gpio29";
				};
			};

			nvt_xtal_en_sleep {
				phandle = <0x24e>;

				mux {
					function = "gpio";
					pins = "gpio29";
				};

				config {
					output-low;
					bias-pull-down;
					drive-strength = <0x02>;
					pins = "gpio29";
				};
			};

			qupv3_se17_2uart_pins {
				phandle = <0x339>;

				qupv3_se17_2uart_tx_active {
					phandle = <0x24a>;

					mux {
						function = "qup3_se4_l2";
						pins = "gpio22";
					};

					config {
						bias-disable;
						drive-strength = <0x02>;
						pins = "gpio22";
					};
				};

				qupv3_se17_2uart_rx_active {
					phandle = <0x24b>;

					mux {
						function = "qup3_se4_l3";
						pins = "gpio23";
					};

					config {
						bias-disable;
						drive-strength = <0x02>;
						pins = "gpio23";
					};
				};

				qupv3_se17_2uart_sleep {
					phandle = <0x24c>;

					mux {
						function = "gpio";
						pins = "gpio22\0gpio23";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio22\0gpio23";
					};
				};
			};
		};
	};

