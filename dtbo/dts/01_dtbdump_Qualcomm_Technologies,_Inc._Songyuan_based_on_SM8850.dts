					function = "gpio";
				};

				config {
					pins = "gpio66";
					drive-strength = <0x08>;
					bias-pull-up;
				};
			};

			mi_ts_spi_miso_active {
				phandle = <0x5d>;

				mux {
					pins = "gpio48";
					function = "qup4_se0_l0";
				};

				config {
					pins = "gpio48";
					drive-strength = <0x04>;
					bias-disable;
				};
			};

			mi_ts_spi_mosi_active {
				phandle = <0x5c>;

				mux {
					pins = "gpio49";
					function = "qup4_se0_l1";
				};

				config {
					pins = "gpio49";
					drive-strength = <0x04>;
					bias-disable;
				};
			};

			mi_ts_spi_clk_active {
				phandle = <0x5e>;

				mux {
					pins = "gpio50";
					function = "qup4_se0_l2";
				};

				config {
					pins = "gpio50";
					drive-strength = <0x04>;
					bias-disable;
				};
			};

			mi_ts_spi_cs_active {
				phandle = <0x5f>;

				mux {
					pins = "gpio51";
					function = "qup4_se0_l3";
				};

				config {
					pins = "gpio51";
					drive-strength = <0x04>;
					bias-pull-up;
				};
			};

			mi_ts_spi_cs_sleep {
				phandle = <0x61>;

				mux {
					pins = "gpio51";
					function = "gpio";
				};

				config {
					pins = "gpio51";
					drive-strength = <0x06>;
					bias-disable;
				};
			};

			mi_ts_spi_sleep {
				phandle = <0x60>;

				mux {
					pins = "gpio48\0gpio49\0gpio50";
					function = "gpio";
				};

				config {
					pins = "gpio48\0gpio49\0gpio50";
					drive-strength = <0x02>;
					bias-disable;
				};
			};
		};
	};

	fragment@48 {
		target = <0xffffffff>;

		__overlay__ {
			status = "ok";
